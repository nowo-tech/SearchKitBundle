{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). Vite only builds the demo entry (assets/app.ts). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ vite_entry_link_tags('app') }}
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_navigation %}
    {% set locale_route = app.request.attributes.get('_route') %}
    {% set locale_params = app.request.attributes.get('_route_params')|default({}) %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('homepage', { _locale: app.request.locale }) }}">{{ 'demo.brand'|trans }}</a>
        <nav class="nowo-ui-menu" aria-label="{{ 'demo.brand'|trans }}">
            <a class="nowo-ui-link" href="{{ path('homepage', { _locale: app.request.locale }) }}"{% if locale_route == 'homepage' %} aria-current="page"{% endif %}>{{ 'demo.action.home'|trans }}</a>
            {% if not app.user %}
                <a class="nowo-ui-link" href="{{ path('demo_login', { _locale: app.request.locale }) }}"{% if locale_route == 'demo_login' %} aria-current="page"{% endif %}>{{ 'demo.login.nav'|trans }}</a>
            {% endif %}
        </nav>
        <div class="nowo-ui-header__end">
            {% if app.user %}
                {# The header search: magnifier → field, Ctrl/⌘ K or "/" (renders nothing for guests). #}
                {{ include('@NowoSearchKitBundle/search.html.twig', {nowo_search_actions: [
                    {title: 'demo.action.home'|trans, url: path('homepage', {_locale: app.request.locale}), kind: 'action'},
                ]}) }}
                <span class="nowo-ui-muted">{{ app.user.userIdentifier }}</span>
                <a class="nowo-ui-link" href="{{ path('demo_logout') }}">{{ 'demo.logout'|trans }}</a>
            {% endif %}
            {% for code, label in {en: 'English', es: 'Español'} %}
                <a class="nowo-ui-link" href="{{ path(locale_route, locale_params|merge({ _locale: code })) }}" hreflang="{{ code }}"{% if app.request.locale == code %} aria-current="true"{% endif %}>{{ code|upper }}</a>
            {% endfor %}
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
    {% block javascripts %}{% endblock %}
{% endblock %}
