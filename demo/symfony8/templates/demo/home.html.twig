{#- Demo home, in the demo platform layout grammar: page header (title, lead, the one primary action), then one
    section card per topic (demo_platform/_section.html.twig). -#}
{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}{% if not app.user %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('demo_login', {_locale: app.request.locale}) }}">{{ 'demo.login.nav'|trans }}</a>{% endif %}{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.heading'|trans, intro: 'demo.lead'|trans, toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.features.title'|trans, kind: 'list', attr: {'data-screenshot-target': ''}} %}
        {% block section_body %}
            <ul class="nowo-ui-list">
                {% for key in ['open', 'groups', 'permissions', 'scope', 'keyboard', 'recent', 'theming'] %}
                    <li class="nowo-ui-list-item">{{ ('demo.features.' ~ key)|trans }}</li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.try.title'|trans, kind: 'detail'} %}
        {% block section_body %}
            <p>{{ (app.user ? 'demo.try.signed_in' : 'demo.try.guest')|trans }}</p>
        {% endblock %}
        {% block section_footer %}
            {% if app.user %}
                {% for id in ['shop', 'billing'] %}
                    <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('demo_project', {_locale: app.request.locale, id: id}) }}">{{ 'demo.try.project'|trans({'%id%': id}) }}</a>
                {% endfor %}
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
