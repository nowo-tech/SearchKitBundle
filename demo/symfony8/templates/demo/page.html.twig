{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: title, intro: text}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: title, kind: 'detail'} %}
        {% block section_body %}<p class="nowo-ui-muted">{{ 'demo.page.hint'|trans }}</p>{% endblock %}
    {% endembed %}
{% endblock %}
