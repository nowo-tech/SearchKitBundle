    { "pattern": "^[-a\\]\\[\\\\\\-\\d^-]$", "match": ["-", "a", "]", "[", "\\", "5", "^"], "noMatch": ["b"] },
    { "pattern": "^[^-\\w]$", "match": ["#"], "noMatch": ["-", "a"] },
    { "pattern": "^[\\--0a-c\\.-\\/]$", "match": ["-", ".", "0", "b"], "noMatch": ["d"] },
